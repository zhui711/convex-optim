{
  "scope": "First assignment only: the two supplied screenshots; no Newton method",
  "gradient_tolerance": 1e-6,
  "max_updates": 10000,
  "precision": "float64",
  "quadratic": {
    "gammas": [0.01, 0.1, 0.3333333333333333, 1.0, 3.0, 10.0, 100.0],
    "initial_point_rule": "[gamma, 1]",
    "relative_gap_diagnostic_threshold": 1e-8
  },
  "exponential": {
    "initial_point": [1.0, 1.0],
    "alphas": [0.01, 0.1, 0.3],
    "betas": [0.3, 0.5, 0.7, 0.9],
    "backtracking_initial_step": 1.0,
    "exact_xtol": 1e-12,
    "exact_rtol": 1e-12
  },
  "gradient_threshold_diagnostics": [1e-4, 1e-5, 1e-6]
}
